{
  "file_format": "fastforwardrs-project",
  "file_format_version": 17,
  "sources": [],
  "plugins": [
    {
      "key": "builtin:blur",
      "version": [
        1,
        0
      ],
      "name": "blur",
      "description": "Softens the picture with a Gaussian blur, of light",
      "category": "Blur and sharpen",
      "domain": "picture",
      "params": [
        {
          "id": "radius",
          "name": "blur",
          "label": "Radius",
          "type": "number",
          "default": 0.0,
          "range": [
            0.0,
            100.0
          ],
          "unit": " pt",
          "decimals": 1
        }
      ]
    },
    {
      "key": "builtin:brightness_contrast",
      "version": [
        1,
        0
      ],
      "name": "brightness and contrast",
      "description": "Makes the picture lighter or darker, and its lights and darks further apart or nearer together",
      "category": "Light",
      "domain": "picture",
      "changes_each_pixel_by_itself": true,
      "params": [
        {
          "id": "brightness",
          "name": "brightness",
          "label": "Brightness",
          "type": "number",
          "default": 0.0,
          "range": [
            -1.0,
            1.0
          ],
          "decimals": 2
        },
        {
          "id": "contrast",
          "name": "contrast",
          "label": "Contrast",
          "type": "number",
          "default": 1.0,
          "range": [
            0.0,
            2.0
          ],
          "decimals": 2
        }
      ]
    },
    {
      "key": "builtin:exposure",
      "version": [
        1,
        0
      ],
      "name": "exposure",
      "description": "Makes the light of the picture brighter or darker, by whole and part stops, as the exposure of a camera does",
      "category": "Light",
      "domain": "picture",
      "changes_each_pixel_by_itself": true,
      "params": [
        {
          "id": "stops",
          "name": "exposure",
          "label": "Amount",
          "type": "number",
          "default": 0.0,
          "range": [
            -5.0,
            5.0
          ],
          "unit": " stops",
          "decimals": 2
        }
      ]
    },
    {
      "key": "builtin:hue_shift",
      "version": [
        1,
        1
      ],
      "name": "hue shift",
      "description": "Turns the colours round the wheel of colours",
      "category": "Colour",
      "domain": "picture",
      "changes_each_pixel_by_itself": true,
      "params": [
        {
          "id": "degrees",
          "name": "hue shift",
          "label": "Turn",
          "type": "number",
          "default": 0.0,
          "range": [
            -180.0,
            180.0
          ],
          "unit": "°",
          "decimals": 1
        }
      ]
    },
    {
      "key": "builtin:opacity",
      "version": [
        1,
        0
      ],
      "name": "opacity",
      "description": "Makes the picture more or less see-through",
      "category": "Transform",
      "domain": "picture",
      "params": [
        {
          "id": "opacity",
          "name": "opacity",
          "label": "Amount",
          "type": "number",
          "default": 1.0,
          "range": [
            0.0,
            1.0
          ],
          "decimals": 2
        }
      ]
    },
    {
      "key": "builtin:saturation",
      "version": [
        1,
        0
      ],
      "name": "saturation",
      "description": "Makes the colours more or less colourful",
      "category": "Colour",
      "domain": "picture",
      "changes_each_pixel_by_itself": true,
      "params": [
        {
          "id": "amount",
          "name": "saturation",
          "label": "Amount",
          "type": "number",
          "default": 1.0,
          "range": [
            0.0,
            2.0
          ],
          "decimals": 2
        }
      ]
    }
  ],
  "tracks": [
    {
      "title": "track 0",
      "gain_decibels": 0.0,
      "speed_factor": 1,
      "muted": false,
      "effects": [
        {
          "effect": "builtin:exposure",
          "version": [
            1,
            0
          ],
          "instance": 0,
          "values": {
            "stops": 0.5
          }
        }
      ],
      "clips": [
        {
          "kind": "text",
          "duration_in_frames": 60,
          "text": "Hello,\nworld",
          "font_family": "Arial",
          "font_size_fraction_of_frame_height": 0.037037037,
          "colour": "#FFC80080",
          "area": {
            "left_fraction_of_frame_width": 0.1,
            "top_fraction_of_frame_height": 0.2,
            "width_fraction_of_frame_width": 0.5,
            "height_fraction_of_frame_height": 0.3
          },
          "rotation_degrees": 15.0,
          "drawer": [
            {
              "property": "degrees",
              "effect": 0,
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.0
                },
                {
                  "frame": 59,
                  "value": 180.0
                }
              ]
            }
          ],
          "effects": [
            {
              "effect": "builtin:hue_shift",
              "version": [
                1,
                1
              ],
              "instance": 0
            },
            {
              "effect": "builtin:saturation",
              "version": [
                1,
                0
              ],
              "instance": 1,
              "values": {
                "amount": 0.5
              }
            },
            {
              "effect": "builtin:opacity",
              "version": [
                1,
                0
              ],
              "instance": 2,
              "values": {
                "opacity": 0.6
              }
            },
            {
              "effect": "builtin:blur",
              "version": [
                1,
                0
              ],
              "instance": 3,
              "values": {
                "radius": 3.0
              }
            },
            {
              "effect": "builtin:brightness_contrast",
              "version": [
                1,
                0
              ],
              "instance": 4,
              "values": {
                "brightness": 0.2,
                "contrast": 1.3
              }
            }
          ]
        }
      ]
    }
  ],
  "speed_indicator": {
    "left_fraction_of_frame_width": 0.03,
    "top_fraction_of_frame_height": 0.04,
    "height_fraction_of_frame_height": 0.08
  }
}
