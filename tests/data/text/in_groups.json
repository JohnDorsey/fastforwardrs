{
  "file_format": "fastforwardrs-project",
  "file_format_version": 17,
  "sources": [],
  "plugins": [
    {
      "key": "builtin:blur",
      "version": [
        1,
        0
      ],
      "name": "blur",
      "description": "Softens the picture with a Gaussian blur, of light",
      "category": "Blur and sharpen",
      "domain": "picture",
      "params": [
        {
          "id": "radius",
          "name": "blur",
          "label": "Radius",
          "type": "number",
          "default": 0.0,
          "range": [
            0.0,
            100.0
          ],
          "unit": " pt",
          "decimals": 1
        }
      ]
    },
    {
      "key": "builtin:hue_shift",
      "version": [
        1,
        1
      ],
      "name": "hue shift",
      "description": "Turns the colours round the wheel of colours",
      "category": "Colour",
      "domain": "picture",
      "changes_each_pixel_by_itself": true,
      "params": [
        {
          "id": "degrees",
          "name": "hue shift",
          "label": "Turn",
          "type": "number",
          "default": 0.0,
          "range": [
            -180.0,
            180.0
          ],
          "unit": "°",
          "decimals": 1
        }
      ]
    },
    {
      "key": "builtin:saturation",
      "version": [
        1,
        0
      ],
      "name": "saturation",
      "description": "Makes the colours more or less colourful",
      "category": "Colour",
      "domain": "picture",
      "changes_each_pixel_by_itself": true,
      "params": [
        {
          "id": "amount",
          "name": "saturation",
          "label": "Amount",
          "type": "number",
          "default": 1.0,
          "range": [
            0.0,
            2.0
          ],
          "decimals": 2
        }
      ]
    }
  ],
  "tracks": [
    {
      "title": "track 1",
      "gain_decibels": 0.0,
      "speed_factor": 1,
      "muted": false,
      "clips": [
        {
          "kind": "text",
          "gap_before_frames": 10,
          "duration_in_frames": 50,
          "text": "Hello,\nworld",
          "font_family": "Arial",
          "font_size_fraction_of_frame_height": 0.037037037,
          "colour": "#FFC80080",
          "area": {
            "left_fraction_of_frame_width": 0.1,
            "top_fraction_of_frame_height": 0.2,
            "width_fraction_of_frame_width": 0.5,
            "height_fraction_of_frame_height": 0.3
          },
          "rotation_degrees": 15.0,
          "badges": [
            {
              "of": {
                "tag": 0
              }
            }
          ]
        }
      ]
    },
    {
      "title": "track 0",
      "gain_decibels": 0.0,
      "speed_factor": 1,
      "muted": false,
      "clips": [
        {
          "kind": "text",
          "duration_in_frames": 50,
          "text": "Text",
          "font_family": "",
          "font_size_fraction_of_frame_height": 0.06,
          "colour": "#FFFFFFFF",
          "area": {
            "left_fraction_of_frame_width": 0.1,
            "top_fraction_of_frame_height": 0.74,
            "width_fraction_of_frame_width": 0.8,
            "height_fraction_of_frame_height": 0.16
          },
          "badges": [
            {
              "of": {
                "tag": 0
              }
            }
          ]
        }
      ]
    }
  ],
  "groups": [
    {
      "kind": "tag",
      "name": "Tag 1",
      "colour": "#647DD8",
      "members": [
        {
          "clip": {
            "track": 1,
            "clip": 0
          }
        },
        {
          "clip": {
            "track": 0,
            "clip": 0
          }
        }
      ],
      "effects": [
        {
          "effect": "builtin:hue_shift",
          "version": [
            1,
            1
          ],
          "instance": 0,
          "values": {
            "degrees": 90.0
          }
        }
      ]
    },
    {
      "kind": "clip_group",
      "name": "Clip group 1",
      "colour": "#4BD254",
      "members": [
        {
          "clip": {
            "track": 1,
            "clip": 0
          }
        },
        {
          "clip": {
            "track": 0,
            "clip": 0
          }
        }
      ],
      "effects": [
        {
          "effect": "builtin:saturation",
          "version": [
            1,
            0
          ],
          "instance": 0,
          "values": {
            "amount": 0.3
          }
        }
      ]
    },
    {
      "kind": "track_group",
      "name": "Track group 1",
      "colour": "#D064D8",
      "members": [
        {
          "track": 1
        },
        {
          "track": 0
        }
      ],
      "effects": [
        {
          "effect": "builtin:blur",
          "version": [
            1,
            0
          ],
          "instance": 0,
          "values": {
            "radius": 2.0
          }
        }
      ]
    }
  ],
  "speed_indicator": {
    "left_fraction_of_frame_width": 0.03,
    "top_fraction_of_frame_height": 0.04,
    "height_fraction_of_frame_height": 0.08
  }
}
